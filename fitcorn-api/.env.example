# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitcorn_web
DB_USERNAME=wahyudi
DB_PASSWORD=Astra123

# JWT
JWT_SECRET=fitcorn_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=fitcorn_refresh_secret_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d

# Redis (for Queue & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Payment Gateway - Midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Ongkir - RajaOngkir
RAJAONGKIR_API_KEY=your_rajaongkir_api_key
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
RAJAONGKIR_ORIGIN_CITY_ID=501

# WhatsApp Gateway
WA_GATEWAY_URL=https://api.fonnte.com/send
WA_GATEWAY_TOKEN=your_fonnte_token
WA_BUSINESS_NUMBER=6281234567890

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@fitcorn.id
SMTP_PASS=your_app_password
EMAIL_FROM=Fitcorn <noreply@fitcorn.id>

# Marketing Pixels (Frontend placeholders)
GTM_ID=GTM-XXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX
FB_PIXEL_ID=XXXXXXXXXXXXXXXXXX
META_CAPI_TOKEN=your_meta_capi_token
TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXX

# Abandoned Cart
ABANDONED_CART_CHECK_INTERVAL=3600000
